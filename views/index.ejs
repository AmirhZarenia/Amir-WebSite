<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <meta name="theme-color" content="#07070b">
    <title>امیر حسین زارع نیا | Web Designer</title>
    <link rel="icon" href="<%= config.Domain %>//image/iconweb.png">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Space+Grotesk:wght@300;400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --bg: #06060a;
            --bg2: #0b0b11;
            --white: #f7f7fb;
            --muted: #9b9ba8;
            --line: rgba(255, 255, 255, .10);
            --violet: #8b5cf6;
            --cyan: #22d3ee;
            --pink: #ec4899;
            --ease: cubic-bezier(.16, 1, .3, 1);
            --font-display: "Space Grotesk", sans-serif;
            --font-code: "JetBrains Mono", monospace;
            --font-fa: "Vazirmatn", sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html {
            scroll-behavior: smooth
        }

        body {
            background: var(--bg);
            color: var(--white);
            font-family: var(--font-fa), sans-serif;
            overflow-x: hidden;
            cursor: none;
        }

        a {
            text-decoration: none;
            color: inherit
        }

        button,
        input,
        textarea {
            font: inherit
        }

        ::selection {
            background: #8b5cf6;
            color: #fff
        }

        ::-webkit-scrollbar {
            width: 7px
        }

        ::-webkit-scrollbar-track {
            background: #050507
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(#8b5cf6, #22d3ee);
            border-radius: 20px
        }

        /* BACKGROUND */
        .noise,
        .grid,
        .aurora,
        .orb-bg {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -10
        }

        .noise {
            opacity: .035;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E")
        }

        .grid {
            background-image: linear-gradient(rgba(255, 255, 255, .028) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .028) 1px, transparent 1px);
            background-size: 70px 70px;
            transform: perspective(700px) rotateX(58deg) scale(1.8);
            transform-origin: center bottom;
            top: 45%;
            opacity: .7;
        }

        .aurora {
            background: radial-gradient(circle at 20% 20%, rgba(139, 92, 246, .18), transparent 25%), radial-gradient(circle at 80% 15%, rgba(34, 211, 238, .13), transparent 24%), radial-gradient(circle at 50% 75%, rgba(236, 72, 153, .09), transparent 25%);
            filter: blur(30px);
            animation: aurora 12s ease-in-out infinite alternate;
        }

        @keyframes aurora {
            to {
                transform: scale(1.08) translate(2%, -1%)
            }
        }

        .orb-bg {
            inset: auto;
            left: 8%;
            top: 30%;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: radial-gradient(circle at 35% 30%, rgba(139, 92, 246, .35), transparent 55%);
            filter: blur(40px)
        }

        /* CURSOR */
        .cursor {
            position: fixed;
            z-index: 99999;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #fff;
            pointer-events: none;
            mix-blend-mode: difference;
            transform: translate(-50%, -50%)
        }

        .cursor-ring {
            position: fixed;
            z-index: 99998;
            width: 42px;
            height: 42px;
            border: 1px solid rgba(255, 255, 255, .6);
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            transition: width .25s, height .25s, border .25s
        }

        .cursor-ring.big {
            width: 72px;
            height: 72px;
            border-color: #8b5cf6
        }

        /* LOADER */
        .loader {
            position: fixed;
            inset: 0;
            background: #050507;
            z-index: 9999;
            display: grid;
            place-items: center;
            transition: opacity .7s, visibility .7s
        }

        .loader.hide {
            opacity: 0;
            visibility: hidden
        }

        .loader-inner {
            text-align: center
        }

        .loader-mark {

            font-weight: 900;
            font-size: 70px;
            letter-spacing: -7px;
            background: linear-gradient(120deg, #fff, #8b5cf6, #22d3ee);
            background-clip: text;
            color: transparent
        }

        .loader-bar {
            width: 180px;
            height: 2px;
            background: #222;
            margin: 18px auto;
            overflow: hidden
        }

        .loader-bar i {
            display: block;
            width: 45%;
            height: 100%;
            background: #fff;
            animation: load 1.1s infinite
        }

        @keyframes load {
            to {
                transform: translateX(300%)
            }
        }

        /* NAV */
        .nav {
            position: fixed;
            z-index: 1000;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: min(1200px, 92%);
            height: 68px;
            padding: 0 18px;
            border: 1px solid transparent;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: .35s var(--ease)
        }

        .nav.scrolled {
            background: rgba(8, 8, 12, .62);
            border-color: var(--line);
            backdrop-filter: blur(22px);
            box-shadow: 0 20px 60px rgba(0, 0, 0, .25)
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-weight: 900;
            direction: ltr
        }

        .logo img {
            width: 39px;
            height: 39px;
            object-fit: contain
        }

        .logo span {
            font-size: 16px
        }

        .nav-links {
            display: flex;
            gap: 28px
        }

        .nav-links a {
            font-size: 13px;
            color: #aaa;
            transition: .3s;
            position: relative
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #fff
        }

        .nav-links a.active:after {
            content: "";
            position: absolute;
            bottom: -10px;
            right: 0;
            width: 18px;
            height: 2px;
            background: linear-gradient(90deg, #8b5cf6, #22d3ee)
        }

        .nav-social {
            display: flex;
            gap: 7px;
            direction: ltr
        }

        .nav-social a {
            width: 36px;
            height: 36px;
            border: 1px solid var(--line);
            border-radius: 11px;
            display: grid;
            place-items: center;
            font: 700 13px var(--font-code), var(--font-fa), sans-serif;
            transition: .3s
        }

        .nav-social a:hover {
            transform: translateY(-4px) rotate(-4deg);
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, .15)
        }

        .menu {
            display: none;
            background: none;
            color: #fff;
            border: 1px solid var(--line);
            width: 42px;
            height: 42px;
            border-radius: 12px
        }

        /* GENERAL */
        .container {
            width: min(1180px, 92%);
            margin: auto
        }

        section {
            position: relative;
            padding: 130px 0
        }

        .kicker {
            font: 700 11px var(--font-display), var(--font-fa), sans-serif;
            letter-spacing: 3px;
            color: #a78bfa;
            direction: ltr
        }

        .section-head {
            margin-bottom: 65px
        }

        .section-head h2 {
            font-size: clamp(38px, 6vw, 78px);
            line-height: 1.05;
            letter-spacing: -2px;
            margin-top: 15px
        }

        .section-head p {
            max-width: 600px;
            color: var(--muted);
            line-height: 2;
            margin-top: 20px;
            font-size: 14px
        }

        .reveal {
            opacity: 0;
            transform: translateY(45px);
            transition: 1s var(--ease)
        }

        .reveal.show {
            opacity: 1;
            transform: none
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            padding-top: 150px;
            display: flex;
            align-items: center;
            overflow: hidden
        }

        .hero-wrap {
            display: grid;
            grid-template-columns: 1.05fr .95fr;
            align-items: center;
            gap: 40px
        }

        .hero-copy {
            position: relative;
            z-index: 2
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 13px;
            border: 1px solid var(--line);
            border-radius: 100px;
            background: rgba(255, 255, 255, .025);
            font-size: 11px;
            color: #bbb
        }

        .eyebrow i {
            width: 7px;
            height: 7px;
            background: #22d3ee;
            border-radius: 50%;
            box-shadow: 0 0 18px #22d3ee
        }

        .hero h1 {
            font-size: clamp(58px, 8vw, 120px);
            line-height: 1.2;
            letter-spacing: -6px;
            margin: 27px 0 25px
        }

        .hero h1 .gradient {
            display: block;
            background: linear-gradient(100deg, #fff 5%, #a78bfa 48%, #22d3ee 95%);
            background-clip: text;
            color: transparent
        }

        .hero h1 small {
            display: block;
            font: 700 clamp(14px, 1.6vw, 20px) Arial, sans-serif;
            letter-spacing: 6px;
            color: #777;
            margin-top: 22px;
            direction: ltr
        }

        .hero-desc {
            max-width: 610px;
            color: #a5a5b0;
            line-height: 2.1;
            font-size: 15px
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-top: 35px;
            flex-wrap: wrap
        }

        .btn {
            position: relative;
            overflow: hidden;
            padding: 15px 23px;
            border-radius: 13px;
            border: 1px solid var(--line);
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: .4s var(--ease);
            font-size: 13px
        }

        .btn.primary {
            border: 0;
            background: #fff;
            color: #08080c
        }

        .btn.primary:before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(100deg, #a78bfa, #22d3ee);
            transform: translateX(100%);
            transition: .5s var(--ease)
        }

        .btn.primary:hover:before {
            transform: none
        }

        .btn span,
        .btn b {
            position: relative;
            z-index: 1
        }

        .btn:hover {
            transform: translateY(-5px)
        }

        .btn.ghost:hover {
            border-color: #8b5cf6;
            background: rgba(139, 92, 246, .08)
        }

        .hero-meta {
            display: flex;
            gap: 35px;
            margin-top: 48px
        }

        .meta strong {
            display: block;
            font: 800 28px var(--font-display), var(--font-fa), sans-serif;
            direction: ltr
        }

        .meta span {
            display: block;
            color: #73737d;
            font-size: 10px;
            margin-top: 6px
        }

        /* 3D SCENE */
        .scene {
            height: 650px;
            position: relative;
            perspective: 1400px;
            display: grid;
            place-items: center
        }

        .scene-glow {
            position: absolute;
            width: 420px;
            height: 420px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(139, 92, 246, .18), transparent 65%);
            filter: blur(20px)
        }

        .cube-wrap {
            width: 370px;
            height: 370px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform .18s ease-out
        }

        .cube {
            position: absolute;
            inset: 42px;
            transform-style: preserve-3d;
            animation: float 6s ease-in-out infinite
        }

        .face {
            position: absolute;
            inset: 0;
            border: 1px solid rgba(255, 255, 255, .15);
            background: linear-gradient(145deg, rgba(255, 255, 255, .11), rgba(255, 255, 255, .025));
            backdrop-filter: blur(8px);
            display: grid;
            place-items: center;
            box-shadow: inset 0 0 70px rgba(139, 92, 246, .08), 0 30px 100px rgba(0, 0, 0, .3)
        }

        .face:after {
            content: "";
            position: absolute;
            width: 50%;
            height: 50%;
            background: radial-gradient(circle, rgba(34, 211, 238, .2), transparent 65%);
            filter: blur(20px)
        }

        .front {
            transform: translateZ(140px)
        }

        .back {
            transform: rotateY(180deg) translateZ(140px)
        }

        .right {
            transform: rotateY(90deg) translateZ(140px)
        }

        .left {
            transform: rotateY(-90deg) translateZ(140px)
        }

        .top {
            transform: rotateX(90deg) translateZ(140px)
        }

        .bottom {
            transform: rotateX(-90deg) translateZ(140px)
        }

        /* ==========================================
   PHOTO INSIDE 3D CUBE
========================================== */

        .cube-photo {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center top;
            display: block;
            position: relative;
            z-index: 2;

            /* کمی سینمایی‌تر */
            filter:
                saturate(1.05) contrast(1.08) brightness(.92);

            /* جلوگیری از بیرون زدن تصویر */
            overflow: hidden;
        }

        /* لایه نور روی عکس */

        .face.front {
            overflow: hidden;
            position: relative;
        }

        /* نور شیشه‌ای روی عکس */

        .face.front::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 3;
            pointer-events: none;

            background:
                linear-gradient(135deg,
                    rgba(255, 255, 255, .18),
                    transparent 25%,
                    transparent 65%,
                    rgba(139, 92, 246, .12));

            mix-blend-mode: screen;
        }

        /* لبه نورانی مکعب */

        .face.front::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 4;
            pointer-events: none;

            border: 1px solid rgba(255, 255, 255, .22);

            box-shadow:
                inset 0 0 40px rgba(139, 92, 246, .18),
                inset 0 0 80px rgba(34, 211, 238, .08);
        }



        .ring {
            position: absolute;
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 50%;
            transform-style: preserve-3d
        }

        .r1 {
            width: 470px;
            height: 470px;
            transform: rotateX(65deg) rotateZ(12deg);
            animation: spin 18s linear infinite
        }

        .r2 {
            width: 530px;
            height: 530px;
            transform: rotateY(65deg) rotateZ(-15deg);
            animation: spin 25s linear infinite reverse
        }

        .r3 {
            width: 390px;
            height: 390px;
            transform: rotateX(80deg) rotateY(20deg);
            animation: spin 14s linear infinite
        }

        .dot {
            position: absolute;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22d3ee;
            box-shadow: 0 0 25px #22d3ee
        }

        .d1 {
            top: 70px;
            right: 30px
        }

        .d2 {
            bottom: 75px;
            left: 25px;
            background: #a78bfa;
            box-shadow: 0 0 25px #a78bfa
        }

        @keyframes float {

            0%,
            100% {
                transform: rotateX(-8deg) rotateY(-18deg) translateY(0)
            }

            50% {
                transform: rotateX(8deg) rotateY(18deg) translateY(-22px)
            }
        }

        @keyframes spin {
            to {
                transform: rotateX(65deg) rotateZ(372deg)
            }
        }

        .scene-tag {
            position: absolute;
            padding: 10px 14px;
            border: 1px solid var(--line);
            background: rgba(5, 5, 8, .55);
            backdrop-filter: blur(15px);
            border-radius: 12px;
            font: 700 10px var(--font-display), var(--font-fa), sans-serif;
            letter-spacing: 1px;
            direction: ltr
        }

        .tag1 {
            top: 110px;
            left: 0
        }

        .tag2 {
            bottom: 100px;
            right: 10px
        }

        .tag3 {
            top: 220px;
            right: -10px
        }



        .marquee {
            width: 100%;
            overflow: hidden;
            border-block: 1px solid var(--line);
            padding: 18px 0;
            background: rgba(255, 255, 255, .018);
            position: relative;
        }

        .marquee-track {
            display: flex;
            align-items: center;
            gap: 0;
            width: max-content;
            direction: ltr;
            will-change: transform;
        }

        .marquee span {
            flex-shrink: 0;
            display: inline-flex;
            align-items: center;
            white-space: nowrap;

            font: 900 32px var(--font-display), var(--font-fa), sans-serif;
            color: #30303a;
            letter-spacing: 3px;

            padding: 0 35px;
        }

        .marquee span b {
            color: #8b5cf6;
            margin-left: 35px;
        }

        /* FEATURE CARDS */
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px
        }

        .feature {
            min-height: 260px;
            padding: 30px;
            border: 1px solid var(--line);
            border-radius: 24px;
            background: linear-gradient(145deg, rgba(255, 255, 255, .055), rgba(255, 255, 255, .015));
            position: relative;
            overflow: hidden;
            transform-style: preserve-3d;
            transition: .4s var(--ease)
        }

        .feature:before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -80px;
            border-radius: 50%;
            background: rgba(139, 92, 246, .16);
            filter: blur(20px)
        }

        .feature:hover {
            border-color: rgba(139, 92, 246, .45);
            transform: translateY(-9px)
        }

        .feature-num {
            font: 700 11px var(--font-code), var(--font-fa), sans-serif;
            color: #666;
            direction: ltr
        }

        .feature-icon {
            font: 700 28px var(--font-code), var(--font-fa), sans-serif;
            margin: 32px 0 18px;
            color: #a78bfa
        }

        .feature h3 {
            font-size: 20px
        }

        .feature p {
            font-size: 13px;
            color: #858591;
            line-height: 2;
            margin-top: 12px
        }

        /* ABOUT */
        .about-grid {
            display: grid;
            grid-template-columns: .9fr 1.1fr;
            gap: 80px;
            align-items: center
        }

        .about-visual {
            height: 570px;
            position: relative;
            perspective: 1000px
        }

        .about-card {
            position: absolute;
            width: 76%;
            height: 82%;
            right: 0;
            top: 0;
            border: 1px solid var(--line);
            border-radius: 28px;
            overflow: hidden;
            transform: rotateY(-9deg) rotateX(3deg);
            box-shadow: 30px 40px 100px rgba(0, 0, 0, .45);
            transition: .5s var(--ease)
        }

        .about-card:hover {
            transform: rotateY(0) rotateX(0) translateY(-8px)
        }

        .about-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: saturate(.9)
        }

        .about-card:after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, transparent 45%, rgba(5, 5, 8, .75))
        }

        .about-mini {
            position: absolute;
            bottom: 20px;
            left: 0;
            width: 48%;
            padding: 22px;
            border: 1px solid var(--line);
            border-radius: 20px;
            background: rgba(12, 12, 17, .7);
            backdrop-filter: blur(18px);
            z-index: 2
        }

        .about-mini strong {
            font: 900 34px var(--font-code), var(--font-fa), sans-serif;
            direction: ltr
        }

        .about-mini span {
            display: block;
            color: #858591;
            font-size: 10px;
            margin-top: 6px
        }

        .about-content h2 {
            font-size: clamp(34px, 5vw, 64px);
            line-height: 1.1;
            margin: 15px 0 25px
        }

        .about-content>p {
            color: #92929d;
            line-height: 2.2;
            font-size: 14px
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 28px
        }

        .info {
            padding: 16px;
            border: 1px solid var(--line);
            border-radius: 15px;
            background: rgba(255, 255, 255, .025)
        }

        .info small {
            color: #666;
            font-size: 9px
        }

        .info strong {
            display: block;
            margin-top: 7px;
            font-size: 12px
        }

        /* SKILLS */
        .skills-layout {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 70px;
            align-items: center
        }

        .skill-intro h2 {
            font-size: 55px;
            line-height: 1.15
        }

        .skill-intro p {
            color: #858591;
            line-height: 2;
            margin-top: 20px
        }

        .skill-list {
            display: grid;
            gap: 13px
        }

        .skill {
            border: 1px solid var(--line);
            padding: 20px;
            border-radius: 17px;
            background: rgba(255, 255, 255, .025);
            transition: .3s
        }

        .skill:hover {
            border-color: #8b5cf6;
            transform: translateX(-6px)
        }

        .skill-top {
            display: flex;
            justify-content: space-between;
            font: 700 12px var(--font-code), var(--font-fa), sans-serif;
            direction: ltr
        }

        .skill-top span:last-child {
            color: #a78bfa
        }

        .track {
            height: 4px;
            background: #202026;
            border-radius: 20px;
            margin-top: 14px;
            overflow: hidden
        }

        .track i {
            display: block;
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, #8b5cf6, #22d3ee);
            transition: 1.8s var(--ease)
        }

        /* SERVICES */
        .service-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px
        }

        .service {
            min-height: 270px;
            border: 1px solid var(--line);
            border-radius: 25px;
            padding: 30px;
            background: linear-gradient(145deg, rgba(255, 255, 255, .045), rgba(255, 255, 255, .012));
            position: relative;
            overflow: hidden;
            transition: .45s var(--ease)
        }

        .service:hover {
            transform: translateY(-8px) rotateX(2deg);
            border-color: rgba(34, 211, 238, .4)
        }

        .service-num {
            font: 700 10px var(--font-code), var(--font-fa), sans-serif;
            color: #555;
            direction: ltr
        }

        .service-icon {
            font: 700 34px var(--font-code), var(--font-fa), sans-serif;
            color: #22d3ee;
            margin: 32px 0 18px
        }

        .service h3 {
            font-size: 22px
        }

        .service p {
            color: #858591;
            line-height: 2;
            margin-top: 12px;
            font-size: 13px
        }

        .service-arrow {
            position: absolute;
            left: 25px;
            bottom: 25px;
            color: #555;
            font: 20px Arial;
            transition: .3s
        }

        .service:hover .service-arrow {
            color: #fff;
            transform: translateX(-5px)
        }

        /* CONTACT */
        .contact-wrap {
            display: grid;
            grid-template-columns: .8fr 1.2fr;
            gap: 18px
        }

        .contact-panel {
            border: 1px solid var(--line);
            border-radius: 26px;
            padding: 35px;
            background: linear-gradient(145deg, rgba(139, 92, 246, .08), rgba(255, 255, 255, .018))
        }

        .contact-panel h3 {
            font-size: 30px
        }

        .contact-panel>p {
            color: #858591;
            line-height: 2;
            margin: 15px 0 30px;
            font-size: 13px
        }

        .contact-item {
            display: flex;
            gap: 15px;
            align-items: center;
            padding: 17px 0;
            border-bottom: 1px solid var(--line)
        }

        .contact-item:last-child {
            border-bottom: 0
        }

        .ci {
            width: 42px;
            height: 42px;
            border: 1px solid var(--line);
            border-radius: 12px;
            display: grid;
            place-items: center;
            font: 700 14px var(--font-code), var(--font-fa), sans-serif;
            color: #a78bfa;
            direction: ltr
        }

        .contact-item small {
            display: block;
            color: #555;
            font-size: 9px
        }

        .contact-item strong {
            display: block;
            font-size: 12px;
            margin-top: 4px
        }

        .form-panel {
            border: 1px solid var(--line);
            border-radius: 26px;
            padding: 30px;
            background: rgba(255, 255, 255, .025)
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px
        }

        .field {
            position: relative
        }

        .field input,
        .field textarea {
            width: 100%;
            background: #0b0b10;
            border: 1px solid #202027;
            color: #fff;
            outline: none;
            border-radius: 13px;
            padding: 17px 15px;
            transition: .3s;
            font-size: 12px
        }

        .field textarea {
            min-height: 170px;
            resize: vertical
        }

        .field input:focus,
        .field textarea:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 4px rgba(139, 92, 246, .07)
        }

        .full {
            grid-column: 1/-1
        }

        .submit {
            margin-top: 12px;
            width: 100%;
            cursor: pointer;
            justify-content: center
        }

        .toast {
            position: fixed;
            left: 25px;
            bottom: 25px;
            padding: 15px 20px;
            border: 1px solid var(--line);
            background: #111117;
            border-radius: 14px;
            transform: translateY(120px);
            opacity: 0;
            transition: .4s;
            z-index: 3000;
            font-size: 12px
        }

        .toast.show {
            transform: none;
            opacity: 1
        }

        /* NEWSLETTER */
        .newsletter {
            border: 1px solid var(--line);
            border-radius: 28px;
            padding: 45px;
            background: radial-gradient(circle at 80% 50%, rgba(34, 211, 238, .09), transparent 35%), linear-gradient(120deg, rgba(139, 92, 246, .1), rgba(255, 255, 255, .025))
        }

        .news-grid {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px
        }

        .newsletter h2 {
            font-size: 42px;
            margin: 10px 0
        }

        .newsletter p {
            color: #858591;
            font-size: 13px
        }

        .news-form {
            display: flex;
            gap: 8px;
            min-width: 420px
        }

        .news-form input {
            flex: 1;
            background: #0b0b10;
            border: 1px solid var(--line);
            border-radius: 13px;
            padding: 15px;
            color: #fff;
            outline: 0
        }

        /* FOOTER */
        footer {
            border-top: 1px solid var(--line);
            padding: 35px 0
        }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #62626d;
            font-size: 10px
        }

        .footer a {
            color: #a78bfa
        }

        /* MODAL */
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .75);
            backdrop-filter: blur(15px);
            z-index: 5000;
            display: grid;
            place-items: center;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: .35s
        }

        .modal.open {
            opacity: 1;
            visibility: visible
        }

        .modal-box {
            width: min(440px, 100%);
            padding: 30px;
            border: 1px solid var(--line);
            border-radius: 25px;
            background: #101016;
            transform: translateY(30px) scale(.96);
            transition: .35s
        }

        .modal.open .modal-box {
            transform: none
        }

        .modal-box h3 {
            font-size: 28px
        }

        .modal-box p {
            color: #8b8b96;
            line-height: 2;
            margin: 15px 0 25px;
            font-size: 13px
        }

        .modal-actions {
            display: flex;
            gap: 10px
        }

        .modal-actions button,
        .modal-actions a {
            flex: 1;
            justify-content: center;
            cursor: pointer
        }

        .modal-close {
            background: #19191f;
            color: #fff
        }

        /* MOBILE */
        @media(max-width:950px) {
            body {
                cursor: auto
            }

            .cursor,
            .cursor-ring {
                display: none
            }

            .nav-links,
            .nav-social {
                display: none
            }

            .menu {
                display: block
            }

            .nav {
                top: 10px
            }

            .nav.mobile-open:after {
                content: "خانه\A\Aدرباره من\A\Aمهارت ها\A\Aخدمات\A\Aارتباط با من";
                white-space: pre;
                position: absolute;
                top: 72px;
                right: 0;
                left: 0;
                padding: 22px;
                background: #0d0d12;
                border: 1px solid var(--line);
                border-radius: 18px;
                line-height: 1.2;
                color: #fff;
                font-size: 13px;
                text-align: right
            }

            .hero {
                padding-top: 120px
            }

            .hero-wrap,
            .about-grid,
            .skills-layout,
            .contact-wrap {
                grid-template-columns: 1fr
            }

            .scene {
                height: 520px;
                order: -1
            }

            .cube-wrap {
                transform: scale(.8)
            }

            .r1 {
                width: 390px;
                height: 390px
            }

            .r2 {
                width: 430px;
                height: 430px
            }

            .hero h1 {
                letter-spacing: -4px
            }

            .feature-grid {
                grid-template-columns: 1fr
            }

            .service-grid {
                grid-template-columns: 1fr
            }

            .about-visual {
                height: 500px
            }

            .about-card {
                width: 82%;
                height: 85%
            }

            .news-grid {
                display: block
            }

            .news-form {
                min-width: 0;
                margin-top: 25px
            }
        }

        @media(max-width:560px) {
            section {
                padding: 90px 0
            }

            .hero h1 {
                font-size: 58px
            }

            .hero-meta {
                gap: 20px
            }

            .meta strong {
                font-size: 23px
            }

            .scene {
                height: 430px
            }

            .cube-wrap {
                transform: scale(.62)
            }

            .tag1 {
                left: 0
            }

            .tag2 {
                right: 0
            }

            .about-visual {
                height: 420px
            }

            .info-grid,
            .form-grid {
                grid-template-columns: 1fr
            }

            .full {
                grid-column: auto
            }

            .newsletter {
                padding: 28px
            }

            .newsletter h2 {
                font-size: 32px
            }

            .news-form {
                flex-direction: column
            }

            .footer {
                display: block;
                text-align: center;
                line-height: 2.3
            }
        }


        /* =========================================================
           PERSIAN FONT OVERRIDE
           Vazirmatn must win whenever the content is Persian.
        ========================================================= */

        :lang(fa),
        html[lang="fa"],
        body[dir="rtl"],
        [dir="rtl"],
        .persian,
        .fa {
            font-family: var(--font-fa), sans-serif !important;
        }

        /* Persian text inside headings must not fall back to Space Grotesk */
        :lang(fa) h1,
        :lang(fa) h2,
        :lang(fa) h3,
        :lang(fa) h4,
        :lang(fa) h5,
        :lang(fa) h6,
        [dir="rtl"] h1,
        [dir="rtl"] h2,
        [dir="rtl"] h3,
        [dir="rtl"] h4,
        [dir="rtl"] h5,
        [dir="rtl"] h6 {
            font-family: var(--font-fa), sans-serif !important;
        }

        /* Keep explicitly English/code elements in their intended fonts */
        .logo,
        .nav-links,
        .nav-social,
        .kicker,
        .scene-tag,
        .marquee,
        .feature-num,
        .service-num,
        .skill-top,
        .code,
        .tech,
        .terminal,
        .nav-code {
            font-family: var(--font-code), monospace;
        }

        /* Persian text in normal content */
        .hero-desc,
        .section-head p,
        .feature p,
        .about-content>p,
        .skill-intro p,
        .contact-item,
        .info,
        .newsletter,
        .modal,
        textarea {
            font-family: var(--font-fa), sans-serif;
        }

        /* =========================================================
           GLOBAL TYPOGRAPHY
           Space Grotesk = modern English / headings
           JetBrains Mono = developer / code / numbers / labels
           Vazirmatn = Persian
        ========================================================= */

        body {
            font-family: var(--font-fa), sans-serif;
        }

        /* Persian-first UI */
        body,
        p,
        li,
        input,
        textarea,
        button {
            font-family: var(--font-fa), sans-serif;
        }

        /* Modern English display typography */
        h1,
        h2,
        h3,
        h4,
        h5,
        h6,
        .logo,
        .nav-links,
        .newsletter h2,
        .about-mini strong {
            font-family: var(--font-display), var(--font-fa), sans-serif;
        }

        /* Developer / coding typography */
        .kicker,
        .hero h1 small,
        .scene-tag,
        .feature-num,
        .service-num,
        .skill-top,
        .meta strong,
        .meta span,
        .about-mini span,
        .nav-social a,
        .marquee span,
        .footer,
        .loader-mark,
        .loader-inner>span,
        .ci,
        .contact-item small,
        .btn,
        .toast,
        .newsletter .kicker,
        .newsletter input {
            font-family: var(--font-code), var(--font-fa), monospace;
        }

        /* English-heavy elements */
        .logo,
        .nav-social,
        .scene-tag,
        .kicker,
        .hero h1 small,
        .feature-num,
        .service-num,
        .skill-top,
        .meta strong,
        .meta span,
        .about-mini span,
        .footer {
            direction: ltr;
        }

        /* Keep Persian fields naturally readable */
        input,
        textarea {
            font-family: var(--font-fa), sans-serif;
        }

        /* Numbers and technical values */
        .skill-top,
        .meta strong,
        .feature-num,
        .service-num {
            font-variant-numeric: tabular-nums;
        }

        /* Marquee: unmistakably developer-style */
        .marquee span {
            font-family: var(--font-code), monospace;
            font-weight: 700;
            letter-spacing: 2px;
        }

        /* Code-like buttons */
        .btn {
            font-weight: 600;
        }

        /* Explicit English/code helper */
        .code,
        .tech,
        .code-text,
        .code-label,
        .terminal,
        .nav-code {
            font-family: var(--font-code), monospace;
        }
    </style>
</head>

