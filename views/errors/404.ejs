<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>404 | صفحه پیدا نشد</title>

    <!-- Vazir CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vazir-font@30.1.0/dist/font-face.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #050507;
            --purple: #8b5cf6;
            --purple2: #a855f7;
            --blue: #6366f1;
            --text: #f8fafc;
            --muted: #94a3b8;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        body {
            font-family: Vazir, sans-serif;
            background: var(--bg);
            color: var(--text);
            overflow: hidden;
        }

        /* =========================
           BACKGROUND
        ========================= */

        .page {
            min-height: 100vh;
            position: relative;

            display: flex;
            align-items: center;
            justify-content: center;

            overflow: hidden;

            background:
                radial-gradient(circle at 50% 40%,
                    rgba(124, 58, 237, .10),
                    transparent 30%),
                #050507;
        }

        /* Grid */

        .grid {
            position: absolute;
            inset: -100px;

            background-image:
                linear-gradient(rgba(139, 92, 246, .06) 1px,
                    transparent 1px),
                linear-gradient(90deg,
                    rgba(139, 92, 246, .06) 1px,
                    transparent 1px);

            background-size: 55px 55px;

            transform:
                perspective(500px) rotateX(55deg) scale(1.5);

            transform-origin: center bottom;

            opacity: .55;
        }

        /* Glow */

        .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            pointer-events: none;
        }

        .glow-1 {
            width: 450px;
            height: 450px;

            top: -200px;
            right: -100px;

            background: rgba(124, 58, 237, .20);
        }

        .glow-2 {
            width: 400px;
            height: 400px;

            bottom: -200px;
            left: -100px;

            background: rgba(79, 70, 229, .16);
        }

        /* =========================
           FLOATING CODE
        ========================= */

        .floating-code {
            position: absolute;

            font-family: Consolas, monospace;

            color: rgba(167, 139, 250, .10);

            font-size: 18px;

            pointer-events: none;

            user-select: none;

            animation: float 8s ease-in-out infinite;
        }

        .fc1 {
            top: 15%;
            left: 8%;
        }

        .fc2 {
            top: 20%;
            right: 10%;

            animation-delay: 1s;
        }

        .fc3 {
            bottom: 15%;
            right: 8%;

            animation-delay: 2s;
        }

        .fc4 {
            bottom: 20%;
            left: 10%;

            animation-delay: 3s;
        }

        @keyframes float {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        /* =========================
           MAIN CONTAINER
        ========================= */

        .container {
            position: relative;

            z-index: 10;

            width: min(1100px, 92%);

            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 70px;

            align-items: center;
        }

        /* =========================
           LEFT
        ========================= */

        .content {
            text-align: right;
        }

        .badge {
            display: inline-flex;

            align-items: center;

            gap: 9px;

            padding: 8px 14px;

            margin-bottom: 22px;

            border-radius: 50px;

            background: rgba(139, 92, 246, .08);

            border: 1px solid rgba(139, 92, 246, .20);

            color: #c4b5fd;

            font-size: 12px;
        }

        .badge-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: #a78bfa;

            box-shadow:
                0 0 15px #8b5cf6;

            animation: blink 1.5s infinite;
        }

        @keyframes blink {

            0%,
            100% {
                opacity: .3;
            }

            50% {
                opacity: 1;
            }
        }

        .title {
            font-size: clamp(28px, 4vw, 50px);

            line-height: 1.5;

            margin-bottom: 15px;

            font-weight: 900;
        }

        .gradient-text {
            background:
                linear-gradient(100deg,
                    #fff,
                    #c4b5fd,
                    #8b5cf6);

            -webkit-background-clip: text;
            background-clip: text;

            -webkit-text-fill-color: transparent;
        }

        .description {
            color: var(--muted);

            font-size: 14px;

            line-height: 2.2;

            max-width: 500px;

            margin-bottom: 28px;
        }

        /* =========================
           BUTTONS
        ========================= */

        .buttons {
            display: flex;

            gap: 12px;

            flex-wrap: wrap;
        }

        .btn {
            height: 50px;

            padding: 0 24px;

            border-radius: 14px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            text-decoration: none;

            font-family: Vazir, sans-serif;

            font-size: 13px;

            transition: .3s;

            position: relative;

            overflow: hidden;
        }

        .btn-primary {
            color: white;

            background:
                linear-gradient(135deg,
                    #7c3aed,
                    #6366f1);

            box-shadow:
                0 15px 35px rgba(124, 58, 237, .22);
        }

        .btn-primary::before {
            content: "";

            position: absolute;

            top: 0;
            left: -100%;

            width: 100%;
            height: 100%;

            background:
                linear-gradient(90deg,
                    transparent,
                    rgba(255, 255, 255, .20),
                    transparent);

            transition: .5s;
        }

        .btn-primary:hover::before {
            left: 100%;
        }

        .btn-primary:hover {
            transform: translateY(-3px);

            box-shadow:
                0 20px 45px rgba(124, 58, 237, .35);
        }

        .btn-secondary {
            color: #c4b5fd;

            background: rgba(139, 92, 246, .05);

            border: 1px solid rgba(139, 92, 246, .20);
        }

        .btn-secondary:hover {
            background: rgba(139, 92, 246, .10);

            border-color: rgba(139, 92, 246, .40);

            transform: translateY(-3px);
        }

        /* =========================
           TERMINAL
        ========================= */

        .terminal-wrapper {
            position: relative;

            perspective: 1200px;
        }

        .terminal {
            position: relative;

            width: 100%;

            border-radius: 22px;

            background:
                linear-gradient(145deg,
                    rgba(24, 24, 38, .90),
                    rgba(9, 9, 16, .92));

            border: 1px solid rgba(139, 92, 246, .25);

            box-shadow:
                0 40px 100px rgba(0, 0, 0, .60),
                0 0 80px rgba(124, 58, 237, .10);

            overflow: hidden;

            transform:
                rotateY(-7deg) rotateX(3deg);

            transition: .5s;
        }

        .terminal:hover {
            transform:
                rotateY(0deg) rotateX(0deg) translateY(-8px);
        }

        /* Terminal header */

        .terminal-header {
            height: 52px;

            padding: 0 18px;

            display: flex;

            align-items: center;

            gap: 8px;

            background: rgba(255, 255, 255, .025);

            border-bottom:
                1px solid rgba(255, 255, 255, .06);
        }

        .terminal-dot {
            width: 11px;
            height: 11px;

            border-radius: 50%;
        }

        .red {
            background: #ef4444;
        }

        .yellow {
            background: #f59e0b;
        }

        .green {
            background: #22c55e;
        }

        .terminal-title {
            margin-right: auto;

            font-family: Consolas, monospace;

            color: #64748b;

            font-size: 11px;

            direction: ltr;
        }

        /* Terminal body */

        .terminal-body {
            padding: 30px;

            min-height: 330px;

            direction: ltr;

            text-align: left;

            font-family:
                Consolas,
                "Courier New",
                monospace;

            font-size: 13px;

            line-height: 2.2;
        }

        .line {
            display: block;

            white-space: nowrap;
        }

        .number {
            display: inline-block;

            width: 30px;

            color: #334155;

            user-select: none;
        }

        .purple {
            color: #c084fc;
        }

        .blue {
            color: #60a5fa;
        }

        .green-text {
            color: #4ade80;
        }

        .red-text {
            color: #f87171;
        }

        .gray {
            color: #64748b;
        }

        .white {
            color: #e2e8f0;
        }

        /* Big 404 */

        .big-404 {
            margin-top: 10px;

            font-family:
                Consolas,
                monospace;

            font-size: 105px;

            line-height: 1;

            font-weight: 900;

            letter-spacing: -8px;

            background:
                linear-gradient(135deg,
                    #fff,
                    #a78bfa,
                    #7c3aed);

            -webkit-background-clip: text;
            background-clip: text;

            -webkit-text-fill-color: transparent;

            filter:
                drop-shadow(0 0 25px rgba(139, 92, 246, .25));
        }

        /* Terminal cursor */

        .cursor {
            display: inline-block;

            width: 7px;
            height: 17px;

            background: #a78bfa;

            vertical-align: middle;

            margin-left: 4px;

            animation: cursor 1s infinite;
        }

        @keyframes cursor {

            0%,
            45% {
                opacity: 1;
            }

            46%,
            100% {
                opacity: 0;
            }
        }

        /* =========================
           ORBIT
        ========================= */

        .orbit {
            position: absolute;

            width: 430px;
            height: 430px;

            border:
                1px solid rgba(139, 92, 246, .08);

            border-radius: 50%;

            top: 50%;
            left: 50%;

            transform:
                translate(-50%, -50%) rotateX(65deg);

            pointer-events: none;
        }

        .orbit::before {
            content: "";

            position: absolute;

            width: 8px;
            height: 8px;

            border-radius: 50%;

            background: #a78bfa;

            box-shadow:
                0 0 25px #8b5cf6;

            top: -4px;
            left: 50%;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 850px) {

            body {
                overflow-y: auto;
            }

            .page {
                min-height: 100vh;

                padding: 60px 0;
            }

            .container {
                grid-template-columns: 1fr;

                gap: 45px;

                width: min(650px, 92%);
            }

            .content {
                text-align: center;

                order: 1;
            }

            .description {
                margin-left: auto;
                margin-right: auto;
            }

            .buttons {
                justify-content: center;
            }

            .terminal-wrapper {
                order: 2;
            }

            .terminal {
                transform: none;
            }

            .terminal:hover {
                transform: translateY(-5px);
            }

            .orbit {
                display: none;
            }
        }

        @media (max-width: 500px) {

            .page {
                padding: 35px 0;
            }

            .container {
                gap: 35px;
            }

            .title {
                font-size: 25px;
            }

            .description {
                font-size: 12px;
            }

            .terminal-body {
                padding: 22px 15px;

                min-height: 280px;

                font-size: 10px;
            }

            .big-404 {
                font-size: 75px;

                letter-spacing: -5px;
            }

            .number {
                width: 24px;
            }

            .terminal-header {
                height: 46px;
            }

            .btn {
                width: 100%;
            }

            .floating-code {
                display: none;
            }
        }
    </style>
</head>

<body>

    <main class="page">

        <!-- Background -->

        <div class="grid"></div>

        <div class="glow glow-1"></div>
        <div class="glow glow-2"></div>

        <!-- Floating Code -->

        <div class="floating-code fc1">
            &lt;div class="developer"&gt;
        </div>

        <div class="floating-code fc2">
            const website = true;
        </div>

        <div class="floating-code fc3">
            npm run build
        </div>

        <div class="floating-code fc4">
            &lt;/body&gt;
        </div>

        <!-- Main -->

        <div class="container">

            <!-- Content -->

            <section class="content">

                <div class="badge">

                    <span class="badge-dot"></span>

                    خطای 404 · Page Not Found

                </div>

                <h1 class="title">

                    اوه!
                    <br>

                    <span class="gradient-text">
                        این صفحه از کدهای ما جا مونده
                    </span>

                </h1>

                <p class="description">

                    آدرسی که دنبالش هستید پیدا نشد.
                    شاید لینک اشتباه وارد شده باشد یا این صفحه
                    به مسیر دیگری منتقل شده باشد.

                    <br>

                    اما نگران نباشید؛
                    فقط یک کلیک تا برگشتن به مسیر اصلی فاصله دارید.

                </p>

                <div class="buttons">

                    <a href="/" class="btn btn-primary">
                        بازگشت به صفحه اصلی
                    </a>

                    <a href="javascript:history.back()" class="btn btn-secondary">

                        صفحه قبلی

                    </a>

                </div>

            </section>

            <!-- Terminal -->

            <section class="terminal-wrapper">

                <div class="orbit"></div>

                <div class="terminal">

                    <div class="terminal-header">

                        <span class="terminal-dot red"></span>
                        <span class="terminal-dot yellow"></span>
                        <span class="terminal-dot green"></span>

                        <span class="terminal-title">
                            amir@zarenia ~ /404
                        </span>

                    </div>

                    <div class="terminal-body">

                        <span class="line">

                            <span class="number">01</span>

                            <span class="purple">const</span>

                            <span class="white">
                                requestedPage
                            </span>

                            <span class="gray">=</span>

                            <span class="green-text">
                                "/requested-page";
                            </span>

                        </span>

                        <span class="line">

                            <span class="number">02</span>

                            <span class="purple">if</span>

                            <span class="white">
                                (!requestedPage)
                            </span>

                            <span class="gray">{</span>

                        </span>

                        <span class="line">

                            <span class="number">03</span>

                            &nbsp;&nbsp;

                            <span class="blue">
                                console
                            </span>

                            <span class="white">.</span>

                            <span class="blue">
                                error
                            </span>

                            <span class="white">
                                (
                            </span>

                            <span class="red-text">
                                "404"
                            </span>

                            <span class="white">
                                );
                            </span>

                        </span>

                        <span class="line">

                            <span class="number">04</span>

                            &nbsp;&nbsp;

                            <span class="blue">
                                redirect
                            </span>

                            <span class="white">
                                (
                            </span>

                            <span class="green-text">
                                "/"
                            </span>

                            <span class="white">
                                );
                            </span>

                        </span>

                        <span class="line">

                            <span class="number">05</span>

                            <span class="gray">}</span>

                        </span>

                        <br>

                        <span class="line">

                            <span class="number">06</span>

                            <span class="gray">
                                // searching for page...
                            </span>

                        </span>

                        <span class="line">

                            <span class="number">07</span>

                            <span class="green-text">
                                ✓ redirect ready
                            </span>

                        </span>

                        <div class="big-404">
                            404
                        </div>

                        <span class="line">

                            <span class="number">08</span>

                            <span class="purple">
                                _
                            </span>

                            <span class="cursor"></span>

                        </span>

                    </div>

                </div>

            </section>

        </div>

    </main>

</body>

</html>